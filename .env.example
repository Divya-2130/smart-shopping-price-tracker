# Rename this file to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

# MySQL database
DB_NAME=smart_shopping_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# RapidAPI (e.g. "Real-Time Product Search" or similar product-data API)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=real-time-product-search.p.rapidapi.com

# Email (using SendGrid as an example)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=alerts@yourapp.com

# SMS (using Twilio as an example)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Celery / Redis (for the background price-check job)
CELERY_BROKER_URL=redis://localhost:6379/0
